prefer-no-csd
debug {
	emulate-zero-presentation-time
}
hotkey-overlay {
	skip-at-startup
}
environment {
	// DISPLAY ":0"
	ELECTRON_OZONE_PLATFORM_HINT "wayland"
	// XCURSOR_THEME "Phinger Cursors (light)"
	// XCURSOR_SIZE "24"
}

animations {
	horizontal-view-movement {
		spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
	}
}

layer-rule {
	// match namespace="^launcher$"
	// baba-is-float true
	match namespace="^wallpaper$"
	place-within-backdrop true
}
overview {
	zoom 0.75
	workspace-shadow {
		// off
	}
}

cursor {
	xcursor-theme "phinger-cursors-light"
	xcursor-size 24
}

input {
	keyboard {
		xkb {
		}
	}
	mouse {
		// natural-scroll
		accel-speed -0.3
		accel-profile "flat"
	}
	// focus-follows-mouse
	touchpad {
		tap
		natural-scroll
	}
}
// top
output "DP-4" {
	// off
	mode "2560x1440@119.998"
	scale 1.0
	transform "normal"
	position x=0 y=0
}
// bottom
output "DP-3" {
	mode "2560x1440@119.998"
	scale 1.0
	transform "normal"
	position x=0 y=1440
}
// tv
output "HDMI-A-5" {
	off
	mode "3840x2160@60.000"
	scale 2.0
	transform "normal"
	position x=-3840 y=1440
}


layout {
	background-color "transparent"
	tab-indicator {
		width 5
		gap 9
		gaps-between-tabs 15
		length total-proportion=0.10
		place-within-column

		active-color   "#eceff4"
		inactive-color "#4c566a"
		urgent-color   "#bf616a"
	}
	gaps 20
	// never, always, on-overflow
	center-focused-column "never"
	shadow {
		on
		softness 0
		spread 4
		// draw-behind-window true
		offset x=6 y=6
		color          "#444444"
		inactive-color "#444444"
	}
	preset-column-widths {
		proportion 0.4
		proportion 0.6
	}
	default-column-width { proportion 0.6; }
	focus-ring {
		width 2
		inactive-color "#000000"
		active-color   "#434759"
	}
	border {
		off
		width 1
		active-color   "#000000"
		inactive-color "#000000"
	}
	struts {
		top     0
		bottom  0
		left    -10
	}
}

//
// Startup applications
//
spawn-at-startup "udiskie" "-s"
spawn-at-startup "blueman-applet"
spawn-at-startup "nm-applet"
spawn-at-startup "swayidle" "-w" "before-sleep" "'swaylock'"

screenshot-path "~/Pictures/Screenshots/Screenshot_from_%Y-%m-%d_%H-%M-%S.png"

//
// blur
//
blur {
	passes 3
	offset 0.8
	saturation 2.0
	noise 0.0
}
window-rule {
	background-effect {
		blur true
	}
}
layer-rule {
	match namespace="^waybar$|^notifications$|^dms:bar$"
	background-effect {
		blur true
		xray false
		saturation 1.0
	}
}
window-rule {
	match app-id="com.mitchellh.ghostty|[tT]hunar"
	match title="foot"
	background-effect {
		blur true
		// xray false
	}
}
window-rule {
	match app-id="com.mitchellh.ghostty"
	match title="foot"
	// opacity 0.80
}
window-rule {
	match app-id=r#"org.quickshell$"#
	match app-id=r#"com.danklinux.dms$"#
	open-floating true
}
layer-rule {
	match namespace="^launcher$"
	background-effect {
		blur true
	}
}

//
// Window Rules
//
window-rule {
	geometry-corner-radius 1
	clip-to-geometry true
}
window-rule {
	match title="Steam"
	default-column-width { proportion 1.0; }
}
// browsers
window-rule {
	match title="Firefox|Vivaldi"
	match app-id="google-chrome|zen|Microsoft-edge"
	default-column-width { proportion 0.60; }
}
window-rule {
	match title="foot|Spotify*"
	match app-id="com.mitchellh.ghostty|udiskie|neovide"
	default-column-width { proportion 0.40; }
}
// floating windows (long)
window-rule {
	match title="Steam Settings|Friends List|Winetricks|REDlauncher|Library|Bluejay"
	match app-id="udiskie|blueman-manager|Jitsi|pavucontrol|neovide|org.gnome.Papers|org.prismlauncher.PrismLauncher"
	open-floating true
	default-column-width { proportion 0.4; }
	default-window-height { proportion 0.8; }
}
window-rule {
	match app-id="scrcpy"
	open-floating true
	default-column-width { proportion 0.2; }
	default-window-height { proportion 0.4; }
}
window-rule {
	match app-id=r#"^org\.gnome\.Calculator$"#
	match app-id=r#"^gnome-calculator$"#
	match app-id=r#"^galculator$"#
	match app-id=r#"^blueman-manager$"#
	match app-id=r#"^org\.gnome\.Nautilus$"#
	match app-id=r#"^xdg-desktop-portal$"#
	open-floating true
}
// floating windows (short)
window-rule {
	match title="File Upload|login|Rockstar Games Launcher"
	match app-id="yazi-float|xdg-desktop-portal-gtk|org.gnome.Nautilus|dolphin|org.gnome.Loupe|swayimg|[tT]hunar|org.gnome.Totem|org.gnome.tweaks|vlc|nemo"
	default-column-width  { proportion 0.5; }
	default-window-height { proportion 0.5; }
	open-floating true
}
// Mod Manager
window-rule {
	match title="Quick Install|Mod Exists|steam_app_489830"
	default-column-width  { proportion 0.5; }
	default-window-height { proportion 0.5; }
	open-floating true
}
window-rule {
	match title="cta|CTA|sso|SSO|[gG]oogle|sign_in|continue|Authview|figma|account|user|content|Sign in|Google|Connecting|about:blank|account|blank|Clicked"
	match app-id="Jitsi"
	default-column-width  { proportion 0.2; }
	default-window-height { proportion 0.2; }
	open-floating true
}
// assign to top monitor
window-rule {
	match app-id="discord"
	open-on-output "DP-4"
	default-column-width { proportion 1.0; }
}
// assign to bottom monitor
window-rule {
	match title="Steam"
	open-on-output "DP-3"
	default-column-width { proportion 1.0; }
	// need this off for tv
	// open-on-output "DP-3"
}
window-rule {
	match app-id="steam"
	// open-on-output "DP-3"
	default-floating-position x=25 y=25 relative-to="bottom-right"
}
// block from stream
window-rule {
	match title="[wW]eather.com|[lL]ogin|Google Messages for web|GroupMe|Google Photos|Gmail"
	block-out-from "screencast"
}

binds {
	Super+Return { spawn "bash" "-c" "ghostty"; }
	// Alt+D { spawn "rofi" "-show" "drun"; }
	// Alt+D { spawn "fuzzel"; }
	Super+D { spawn "vicinae" "toggle"; }
	Super+F12 { spawn "pavucontrol" "-t" "1"; }
	// Ctrl+Super+L { spawn "swaylock"; }
	// Alt+Shift+n { spawn "swaync-client" "-t"; }
	// Alt+Shift+n { spawn "/home/sven/.config/mako/history.sh"; }
	// Super+e { spawn "thunar"; }
	// Super+e { spawn "foot" "--app-id" "yazi-float" "y"; }
	Super+e { spawn "nemo"; }
	// Ctrl+Alt+Delete { spawn "/home/sven/.config/niri/power.sh"; }
	Ctrl+Alt+Delete { spawn "vicinae" "vicinae://launch/power"; }
	Ctrl+Super+Shift+P { spawn "/home/sven/.config/niri/screen.sh"; }

	// taskbar
	// Super+1 { spawn "gtk-launch" "com.microsoft.Edge"; }
	Super+1 { spawn "helium"; }
	Super+2 { spawn "discord"; }
	Super+3 { spawn "flatpak" "run" "com.valvesoftware.Steam"; }

	// Ctrl+Print {
	// 	spawn "sh" "-c" r#"
	// 	file=~/Videos/recordings/"$(date +%s)".mp4
	// 	wf-recorder -c h264_nvenc -r 60 --bframes 0 -g "$(slurp -b '#00000090' -w 0)" -f "$file"
	// 	wl-copy file:/"$file" -t text/uri-list
	// 	"#;
	// }
	Ctrl+Print {
		spawn "sh" "-c" r#"
		file=~/Videos/recordings/"$(date +%s)".mp4
		wf-recorder -r 60 --bframes 0 -g "$(slurp -b '#00000090' -w 0)" -f "$file"
		wl-copy file:/"$file" -t text/uri-list
		"#;
	}

	Ctrl+Escape { spawn "killall" "-s" "SIGINT" "wf-recorder"; }

	//
	// Audio
	//
	XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.01+"; }
	XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.01-"; }
	XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute"   "@DEFAULT_AUDIO_SINK@" "toggle"; }
	XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute"   "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

	//
	// Window management
	//
	Super+Shift+Q { close-window; }

	Super+Tab { toggle-overview; }

	Super+H { focus-column-left; }
	Super+J { focus-window-or-monitor-down; }
	Super+K { focus-window-or-monitor-up; }
	Super+L { focus-column-right; }
	Super+WheelScrollUp { focus-window-or-monitor-up; }
	Super+WheelScrollDown { focus-window-or-monitor-down; }
	Super+WheelScrollLeft { focus-column-left; }
	Super+WheelScrollRight { focus-column-right; }

	Super+Shift+n { move-window-to-monitor-next; }
	Super+Shift+p { move-window-to-monitor-previous; }
	Super+Shift+H { move-column-left-or-to-monitor-left; }
	Super+Shift+J { move-window-down; }
	Super+Shift+K { move-window-up; }
	Super+Shift+L { move-column-right-or-to-monitor-right; }

	// Alt+Home { focus-column-first; }
	// Alt+End  { focus-column-last; }
	// Alt+Ctrl+Home { move-column-to-first; }
	// Alt+Ctrl+End  { move-column-to-last; }

	// Super+Shift+H { focus-monitor-left; }
	// Super+Shift+J { focus-monitor-down; }
	// Super+Shift+K { focus-monitor-up; }
	// Super+Shift+L { focus-monitor-right; }
	Super+n { focus-monitor-next; }
	Super+p { focus-monitor-previous; }

	// Ctrl+Super+Shift+H { move-column-to-monitor-left; }
	// Ctrl+Super+Shift+J { move-column-to-monitor-down; }
	// Ctrl+Super+Shift+K { move-column-to-monitor-up; }
	// Ctrl+Super+Shift+L { move-column-to-monitor-right; }

	// Alt+Ctrl+j { focus-workspace-down; }
	// Alt+Ctrl+k { focus-workspace-up; }
	// Super+WheelScrollDown { focus-workspace-down; }
	// Super+WheelScrollUp { focus-workspace-up; }
	Super+Page_Down{ focus-workspace-down; }
	Super+Page_Up { focus-workspace-up; }
	// Alt+Shift+Ctrl+j { move-column-to-workspace-down; }
	// Alt+Shift+Ctrl+k { move-column-to-workspace-up; }
	// Alt+Shift+WheelScrollDown { move-column-to-workspace-down; }
	// Alt+Shift+WheelScrollUp   { move-column-to-workspace-up; }

	Super+Shift+Page_Down { move-workspace-down; }
	Super+Shift+Page_Up   { move-workspace-up; }
	// Alt+Shift+U         { move-workspace-down; }
	// Alt+Shift+I         { move-workspace-up; }

	// Alt+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
	// Alt+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
	// Alt+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
	// Alt+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

	// Alt+WheelScrollRight      { focus-column-right; }
	// Alt+WheelScrollLeft       { focus-column-left; }
	// Alt+WheelScrollDown			{ focus-column-right; }
	// Alt+WheelScrollUp			{ focus-column-left; }
	// Alt+Shift+WheelScrollDown	{ move-column-right; }
	// Alt+Shift+WheelScrollUp  	{ move-column-left; }

	// Alt+1 { focus-workspace 1; }
	// Alt+2 { focus-workspace 2; }
	// Alt+3 { focus-workspace 3; }
	// Alt+4 { focus-workspace 4; }
	// Alt+5 { focus-workspace 5; }
	// Alt+6 { focus-workspace 6; }
	// Alt+7 { focus-workspace 7; }
	// Alt+8 { focus-workspace 8; }
	// Alt+9 { focus-workspace 9; }
	// Alt+Shift+1 { move-column-to-workspace 1; }
	// Alt+Shift+2 { move-column-to-workspace 2; }
	// Alt+Shift+3 { move-column-to-workspace 3; }
	// Alt+Shift+4 { move-column-to-workspace 4; }
	// Alt+Shift+5 { move-column-to-workspace 5; }
	// Alt+Shift+6 { move-column-to-workspace 6; }
	// Alt+Shift+7 { move-column-to-workspace 7; }
	// Alt+Shift+8 { move-column-to-workspace 8; }
	// Alt+Shift+9 { move-column-to-workspace 9; }

	//
	// Consuming, Expelling
	//
	Alt+C { center-column; }
	// Ctrl+Comma { consume-or-expel-window-left; }
	// Ctrl+Period { consume-or-expel-window-right; }
	// Alt+Comma  { consume-window-into-column; }
	// Alt+Period { expel-window-from-column; }
	Alt+BracketLeft  { consume-or-expel-window-left; }
	Alt+BracketRight { consume-or-expel-window-right; }

	//
	// Tabs
	//
	// Alt+W { toggle-column-tabbed-display; }

	//
	// Resizing
	//
	Super+F { maximize-column; }
	// Alt+Shift+F { reset-window-height; }
	F11 { fullscreen-window; }
	Shift+F11 { toggle-windowed-fullscreen; }
	Super+Minus { set-column-width "-20%"; }
	Super+Equal { set-column-width "+20%"; }
	Super+R { switch-preset-column-width; }
	// Alt+Shift+R { reset-window-height; }
	Super+Space { switch-focus-between-floating-and-tiling; }
	Super+Shift+Space { toggle-window-floating; }

	//
	// Screenshotting
	//
	Print { screenshot; }
	Shift+Print { screenshot-screen; }
	Super+Print { screenshot-window; }

	// The quit action will show a confirmation dialog to avoid accidental exits.
	Super+Shift+E { quit; }
}


include "dms/outputs.kdl"
include "dms/binds.kdl"

include "dms/cursor.kdl"
